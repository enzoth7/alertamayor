@@ -0,0 +1,158 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+
+type GoogleMapsRuntime = {
+  maps?: {
+    importLibrary?: (library: string) => Promise<unknown>;
+  };
+};
+
+type GoogleWindow = Window &
+  typeof globalThis & {
+    google?: GoogleMapsRuntime;
+    __alertaMayorGoogleMapsReady?: () => void;
+    __alertaMayorGoogleMapsPromise?: Promise<void>;
+  };
+
+function loadGooglePlacesUiKit(apiKey: string): Promise<void> {
+  const browser = window as GoogleWindow;
+  if (browser.__alertaMayorGoogleMapsPromise) {
+    return browser.__alertaMayorGoogleMapsPromise;
+  }
+
+  browser.__alertaMayorGoogleMapsPromise = (async () => {
+    if (!browser.google?.maps?.importLibrary) {
+      await new Promise<void>((resolvePromise, rejectPromise) => {
+        const existing = document.querySelector<HTMLScriptElement>(
+          'script[data-alerta-mayor-google-maps="true"]',
+        );
+        browser.__alertaMayorGoogleMapsReady = resolvePromise;
+
+        if (existing) {
+          existing.addEventListener("error", () => rejectPromise(new Error("No se pudo cargar Google Maps.")), {
+            once: true,
+          });
+          return;
+        }
+
+        const script = document.createElement("script");
+        script.dataset.alertaMayorGoogleMaps = "true";
+        script.async = true;
+        script.src =
+          `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}` +
+          "&v=weekly&loading=async&auth_referrer_policy=origin" +
+          "&callback=__alertaMayorGoogleMapsReady";
+        script.addEventListener(
+          "error",
+          () => rejectPromise(new Error("No se pudo cargar Google Maps.")),
+          { once: true },
+        );
+        document.head.append(script);
+      });
+    }
+
+    const importLibrary = browser.google?.maps?.importLibrary;
+    if (!importLibrary) {
+      throw new Error("Google Maps no expuso importLibrary().");
+    }
+    await importLibrary("places");
+    await customElements.whenDefined("gmp-place-details");
+  })();
+
+  return browser.__alertaMayorGoogleMapsPromise;
+}
+
+export type GooglePlaceDetailsProps = {
+  placeId: string;
+  apiKey?: string;
+  enabled?: boolean;
+  className?: string;
+};
+
+/**
+ * PRUEBA TÉCNICA, DESHABILITADA POR DEFECTO.
+ *
+ * No activar en producción sin confirmar por escrito la compatibilidad de los
+ * términos de Google Maps Platform con la función de directorio de Alerta Mayor.
+ * Para producción, preferir GoogleMapsReviewLink y una Maps URL.
+ */
+export default function GooglePlaceDetails({
+  placeId,
+  apiKey = process.env.NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY || "",
+  enabled = process.env.NEXT_PUBLIC_ENABLE_GOOGLE_PLACE_UI_KIT === "true",
+  className,
+}: GooglePlaceDetailsProps) {
+  const containerRef = useRef<HTMLDivElement>(null);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    let cancelled = false;
+    const container = containerRef.current;
+    const normalizedPlaceId = placeId.trim();
+
+    if (!container) return;
+    container.replaceChildren();
+
+    if (!enabled) {
+      setError("Places UI Kit está deshabilitado. Use el enlace externo a Google Maps.");
+      return;
+    }
+
+    if (!normalizedPlaceId) {
+      setError("No hay un identificador de Google para este establecimiento.");
+      return;
+    }
+    if (!apiKey) {
+      setError("Falta NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY.");
+      return;
+    }
+
+    setError("");
+    void loadGooglePlacesUiKit(apiKey)
+      .then(() => {
+        if (cancelled || !containerRef.current) return;
+
+        const details = document.createElement("gmp-place-details");
+        details.style.display = "block";
+        details.style.width = "100%";
+        details.style.minWidth = "250px";
+        details.style.maxWidth = "400px";
+        details.style.maxHeight = "560px";
+        details.style.overflow = "auto";
+
+        const request = document.createElement("gmp-place-details-place-request");
+        request.setAttribute("place", normalizedPlaceId);
+
+        const content = document.createElement("gmp-place-content-config");
+        content.append(
+          document.createElement("gmp-place-address"),
+          document.createElement("gmp-place-rating"),
+          document.createElement("gmp-place-reviews"),
+        );
+
+        details.append(request, content);
+        containerRef.current.replaceChildren(details);
+      })
+      .catch((reason: unknown) => {
+        if (cancelled) return;
+        setError(reason instanceof Error ? reason.message : "No se pudo cargar la información de Google.");
+      });
+
+    return () => {
+      cancelled = true;
+      container.replaceChildren();
+    };
+  }, [apiKey, enabled, placeId]);
+
+  return (
+    <section className={className} aria-label="Información pública mostrada por Google">
+      {error ? <p role="status">{error}</p> : null}
+      <div ref={containerRef} />
+      <p style={{ marginTop: "0.75rem", fontSize: "0.82rem", lineHeight: 1.4 }}>
+        Información presentada en vivo por Google. Alerta Mayor no la interpreta como una constatación ni la
+        incorpora automáticamente al estado administrativo del establecimiento.
+      </p>
+    </section>
+  );
+}
