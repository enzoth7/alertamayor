diff --git a/research/train_review_baseline.py b/research/train_review_baseline.py
new file mode 100644
index 0000000..6412a76
--- /dev/null
+++ b/research/train_review_baseline.py
@@ -0,0 +1,278 @@
+#!/usr/bin/env python3
+"""Baseline reproducible para señales específicas en textos autorizados de Alerta Mayor.
+
+No usar con reseñas de Google ni con textos obtenidos contra los términos/licencias
+aplicables. La unidad de separación es el establecimiento, para evitar que textos del
+mismo ELEPEM aparezcan a la vez en entrenamiento y evaluación.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+import joblib
+import numpy as np
+import pandas as pd
+from scipy.sparse import csr_matrix, hstack
+from sklearn.feature_extraction.text import TfidfVectorizer
+from sklearn.linear_model import LogisticRegression
+from sklearn.metrics import (
+    average_precision_score,
+    confusion_matrix,
+    f1_score,
+    precision_recall_curve,
+    precision_score,
+    recall_score,
+    roc_auc_score,
+)
+from sklearn.model_selection import GroupShuffleSplit
+
+REQUIRED_COLUMNS = {
+    "review_id",
+    "facility_id",
+    "review_text",
+    "label_specific_signal",
+}
+
+
+def parse_bool(value: Any) -> bool:
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, np.integer)):
+        return bool(value)
+    normalized = str(value).strip().lower()
+    if normalized in {"1", "true", "t", "yes", "si", "sí"}:
+        return True
+    if normalized in {"0", "false", "f", "no"}:
+        return False
+    raise ValueError(f"Etiqueta booleana inválida: {value!r}")
+
+
+def validate_frame(frame: pd.DataFrame) -> pd.DataFrame:
+    missing = REQUIRED_COLUMNS.difference(frame.columns)
+    if missing:
+        raise ValueError(f"Faltan columnas obligatorias: {', '.join(sorted(missing))}")
+
+    clean = frame.copy()
+    clean["review_id"] = clean["review_id"].astype(str).str.strip()
+    clean["facility_id"] = clean["facility_id"].astype(str).str.strip()
+    clean["review_text"] = clean["review_text"].fillna("").astype(str).str.strip()
+    clean["label_specific_signal"] = clean["label_specific_signal"].map(parse_bool).astype(int)
+    if "rating" not in clean.columns:
+        clean["rating"] = np.nan
+    clean["rating"] = pd.to_numeric(clean["rating"], errors="coerce")
+
+    clean = clean[
+        (clean["review_id"] != "")
+        & (clean["facility_id"] != "")
+        & (clean["review_text"].str.len() >= 20)
+    ].drop_duplicates(subset=["review_id"], keep="last")
+
+    if clean["facility_id"].nunique() < 5:
+        raise ValueError("Se necesitan textos de al menos cinco establecimientos distintos.")
+    if len(clean) < 30:
+        raise ValueError("Se necesitan al menos 30 textos para ejecutar esta prueba técnica.")
+    if clean["label_specific_signal"].nunique() < 2:
+        raise ValueError("Las etiquetas deben contener ejemplos positivos y negativos.")
+    return clean.reset_index(drop=True)
+
+
+def split_by_facility(frame: pd.DataFrame, seed: int) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
+    outer = GroupShuffleSplit(n_splits=1, test_size=0.20, random_state=seed)
+    train_val_idx, test_idx = next(
+        outer.split(frame, y=frame["label_specific_signal"], groups=frame["facility_id"])
+    )
+    train_val = frame.iloc[train_val_idx].reset_index(drop=True)
+    test = frame.iloc[test_idx].reset_index(drop=True)
+
+    inner = GroupShuffleSplit(n_splits=1, test_size=0.25, random_state=seed + 1)
+    train_idx, validation_idx = next(
+        inner.split(
+            train_val,
+            y=train_val["label_specific_signal"],
+            groups=train_val["facility_id"],
+        )
+    )
+    return (
+        train_val.iloc[train_idx].reset_index(drop=True),
+        train_val.iloc[validation_idx].reset_index(drop=True),
+        test,
+    )
+
+
+def numeric_features(frame: pd.DataFrame) -> csr_matrix:
+    rating = frame["rating"].clip(1, 5)
+    rating_missing = rating.isna().astype(float).to_numpy()
+    rating_scaled = rating.fillna(3).to_numpy(dtype=float) / 5.0
+    length_scaled = frame["review_text"].str.len().clip(upper=2_000).to_numpy(dtype=float) / 2_000.0
+    return csr_matrix(np.column_stack([rating_scaled, rating_missing, length_scaled]))
+
+
+def build_features(
+    vectorizer: TfidfVectorizer,
+    frame: pd.DataFrame,
+    *,
+    fit: bool,
+):
+    text_matrix = (
+        vectorizer.fit_transform(frame["review_text"])
+        if fit
+        else vectorizer.transform(frame["review_text"])
+    )
+    return hstack([text_matrix, numeric_features(frame)], format="csr")
+
+
+def choose_threshold(y_true: np.ndarray, probabilities: np.ndarray, target_precision: float) -> dict[str, float | str]:
+    precision, recall, thresholds = precision_recall_curve(y_true, probabilities)
+    candidates: list[tuple[float, float, float, float]] = []
+    for index, threshold in enumerate(thresholds):
+        p = float(precision[index])
+        r = float(recall[index])
+        f1 = 0.0 if p + r == 0 else 2 * p * r / (p + r)
+        candidates.append((float(threshold), p, r, f1))
+
+    meeting_target = [row for row in candidates if row[1] >= target_precision]
+    if meeting_target:
+        threshold, p, r, f1 = max(meeting_target, key=lambda row: (row[2], row[3], row[0]))
+        strategy = f"mayor recall con precision >= {target_precision:.2f}"
+    else:
+        threshold, p, r, f1 = max(candidates, key=lambda row: (row[3], row[1], row[2]))
+        strategy = "mejor F1; no se alcanzó la precisión objetivo"
+    return {
+        "threshold": threshold,
+        "validation_precision": p,
+        "validation_recall": r,
+        "validation_f1": f1,
+        "strategy": strategy,
+    }
+
+
+def safe_auc(y_true: np.ndarray, probabilities: np.ndarray) -> float | None:
+    return float(roc_auc_score(y_true, probabilities)) if len(np.unique(y_true)) == 2 else None
+
+
+def metrics(y_true: np.ndarray, probabilities: np.ndarray, threshold: float) -> dict[str, Any]:
+    predicted = (probabilities >= threshold).astype(int)
+    return {
+        "threshold": threshold,
+        "precision": float(precision_score(y_true, predicted, zero_division=0)),
+        "recall": float(recall_score(y_true, predicted, zero_division=0)),
+        "f1": float(f1_score(y_true, predicted, zero_division=0)),
+        "average_precision": float(average_precision_score(y_true, probabilities)),
+        "roc_auc": safe_auc(y_true, probabilities),
+        "confusion_matrix": confusion_matrix(y_true, predicted, labels=[0, 1]).tolist(),
+        "n": int(len(y_true)),
+        "positives": int(y_true.sum()),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", required=True, help="CSV de textos autorizados y etiquetas adjudicadas.")
+    parser.add_argument("--out-dir", default="research/output/review-baseline")
+    parser.add_argument("--seed", type=int, default=20260801)
+    parser.add_argument("--target-precision", type=float, default=0.80)
+    args = parser.parse_args()
+
+    if not 0 < args.target_precision <= 1:
+        raise ValueError("--target-precision debe estar entre 0 y 1.")
+
+    frame = validate_frame(pd.read_csv(args.input))
+    train, validation, test = split_by_facility(frame, args.seed)
+
+    for name, split in {"train": train, "validation": validation, "test": test}.items():
+        if split["label_specific_signal"].nunique() < 2:
+            raise ValueError(
+                f"La partición {name} quedó con una sola clase. Incorporá más establecimientos o cambiá la semilla."
+            )
+
+    vectorizer = TfidfVectorizer(
+        lowercase=True,
+        strip_accents="unicode",
+        ngram_range=(1, 2),
+        min_df=2,
+        max_df=0.98,
+        max_features=40_000,
+        sublinear_tf=True,
+    )
+    x_train = build_features(vectorizer, train, fit=True)
+    x_validation = build_features(vectorizer, validation, fit=False)
+    x_test = build_features(vectorizer, test, fit=False)
+
+    model = LogisticRegression(
+        class_weight="balanced",
+        max_iter=2_000,
+        solver="liblinear",
+        random_state=args.seed,
+    )
+    model.fit(x_train, train["label_specific_signal"].to_numpy())
+
+    validation_probabilities = model.predict_proba(x_validation)[:, 1]
+    threshold_info = choose_threshold(
+        validation["label_specific_signal"].to_numpy(),
+        validation_probabilities,
+        args.target_precision,
+    )
+    threshold = float(threshold_info["threshold"])
+    test_probabilities = model.predict_proba(x_test)[:, 1]
+
+    output_dir = Path(args.out_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    artifact_path = output_dir / "model.joblib"
+    metrics_path = output_dir / "metrics.json"
+    predictions_path = output_dir / "test_predictions.csv"
+
+    report = {
+        "purpose": "triage research only; not proof of abuse or regulatory non-compliance",
+        "data_scope": "first-party, open-licensed, or explicitly authorized texts only",
+        "split_unit": "facility_id",
+        "seed": args.seed,
+        "taxonomy_version": "uy-elepem-v0.1",
+        "rows": {
+            "total": len(frame),
+            "train": len(train),
+            "validation": len(validation),
+            "test": len(test),
+        },
+        "facilities": {
+            "total": int(frame["facility_id"].nunique()),
+            "train": int(train["facility_id"].nunique()),
+            "validation": int(validation["facility_id"].nunique()),
+            "test": int(test["facility_id"].nunique()),
+        },
+        "threshold_selection": threshold_info,
+        "test": metrics(
+            test["label_specific_signal"].to_numpy(),
+            test_probabilities,
+            threshold,
+        ),
+    }
+
+    joblib.dump(
+        {
+            "vectorizer": vectorizer,
+            "model": model,
+            "threshold": threshold,
+            "numeric_features": ["rating_scaled", "rating_missing", "review_length_scaled"],
+            "taxonomy_version": "uy-elepem-v0.1",
+        },
+        artifact_path,
+    )
+    metrics_path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+    predictions = test[["review_id", "facility_id", "label_specific_signal"]].copy()
+    predictions["probability_specific_signal"] = test_probabilities
+    predictions["predicted_specific_signal"] = test_probabilities >= threshold
+    predictions.to_csv(predictions_path, index=False)
+
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+    print(f"Modelo: {artifact_path}")
+    print(f"Métricas: {metrics_path}")
+    print(f"Predicciones de prueba: {predictions_path}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/discover-osm-elepem.mjs b/scripts/discover-osm-elepem.mjs
new file mode 100644
index 0000000..f21c7e0
--- /dev/null
+++ b/scripts/discover-osm-elepem.mjs
@@ -0,0 +1,180 @@
+import { mkdir, writeFile } from "node:fs/promises";
+import { dirname, resolve } from "node:path";
+
+const OVERPASS_ENDPOINT =
+  process.env.OVERPASS_ENDPOINT || "https://overpass-api.de/api/interpreter";
+
+const OVERPASS_QUERY = String.raw`[out:json][timeout:180];
+area["ISO3166-1"="UY"]["boundary"="administrative"]["admin_level"="2"]->.uy;
+(
+  nwr["amenity"="social_facility"]
+     ["social_facility"~"^(nursing_home|assisted_living|care_home|group_home)$"]
+     ["social_facility:for"~"(^|;)senior(;|$)"](area.uy);
+  nwr["amenity"="social_facility"]
+     ["social_facility"~"^(nursing_home|assisted_living|care_home)$"](area.uy);
+  nwr["amenity"="nursing_home"](area.uy);
+  nwr["amenity"="retirement_home"](area.uy);
+  nwr["healthcare"="nursing_home"](area.uy);
+);
+out center tags;`;
+
+function argumentValue(name) {
+  const index = process.argv.indexOf(name);
+  return index >= 0 ? process.argv[index + 1] : undefined;
+}
+
+function dateStamp() {
+  return new Date().toISOString().slice(0, 10);
+}
+
+function text(value) {
+  return typeof value === "string" ? value.trim() : "";
+}
+
+function number(value) {
+  const parsed = Number(value);
+  return Number.isFinite(parsed) ? parsed : null;
+}
+
+function coordinates(element) {
+  const lat = number(element.lat ?? element.center?.lat);
+  const lng = number(element.lon ?? element.center?.lon);
+  return lat === null || lng === null ? null : { lat, lng };
+}
+
+function addressFromTags(tags) {
+  const street = text(tags["addr:street"] || tags["addr:place"]);
+  const door = text(tags["addr:housenumber"]);
+  const unit = text(tags["addr:unit"]);
+  return [street, door, unit].filter(Boolean).join(" ");
+}
+
+function localityFromTags(tags) {
+  return text(
+    tags["addr:city"] ||
+      tags["addr:town"] ||
+      tags["addr:village"] ||
+      tags["addr:suburb"] ||
+      tags["is_in:city"],
+  );
+}
+
+function departmentFromTags(tags) {
+  return text(
+    tags["addr:state"] ||
+      tags["is_in:state"] ||
+      tags["is_in:department"] ||
+      tags["addr:province"],
+  );
+}
+
+function mapElement(element, retrievedAt) {
+  const tags = element.tags && typeof element.tags === "object" ? element.tags : {};
+  const location = coordinates(element);
+  const name = text(tags.name || tags.official_name || tags.operator || tags.brand);
+  if (!name || !location) return null;
+
+  const osmId = `${element.type}/${element.id}`;
+  return {
+    sourceType: "osm",
+    sourceRecordKey: `osm:${element.type}:${element.id}`,
+    externalId: osmId,
+    externalUrl: `https://www.openstreetmap.org/${osmId}`,
+    sourceLicense: "ODbL-1.0",
+    attribution: "© OpenStreetMap contributors",
+    retrievedAt,
+    name,
+    department: departmentFromTags(tags),
+    locality: localityFromTags(tags),
+    address: addressFromTags(tags),
+    lat: location.lat,
+    lng: location.lng,
+    tags,
+  };
+}
+
+async function sleep(milliseconds) {
+  await new Promise((resolvePromise) => setTimeout(resolvePromise, milliseconds));
+}
+
+async function fetchOverpass() {
+  let lastError;
+  for (let attempt = 1; attempt <= 3; attempt += 1) {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 210_000);
+    try {
+      const response = await fetch(OVERPASS_ENDPOINT, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
+          "User-Agent":
+            process.env.ALERTA_MAYOR_USER_AGENT ||
+            "AlertaMayor/0.1 (public-interest ELEPEM discovery; https://alertamayor.vercel.app/)",
+        },
+        body: new URLSearchParams({ data: OVERPASS_QUERY }),
+        signal: controller.signal,
+      });
+      if (!response.ok) {
+        throw new Error(`Overpass respondió ${response.status}: ${(await response.text()).slice(0, 500)}`);
+      }
+      return response.json();
+    } catch (error) {
+      lastError = error;
+      if (attempt < 3) await sleep(attempt * 5_000);
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+  throw lastError;
+}
+
+async function main() {
+  const outputPath = resolve(
+    argumentValue("--out") || `data/discovery/osm-elepem-candidates-${dateStamp()}.json`,
+  );
+  const retrievedAt = new Date().toISOString();
+  const payload = await fetchOverpass();
+  const elements = Array.isArray(payload?.elements) ? payload.elements : [];
+  const candidates = elements
+    .map((element) => mapElement(element, retrievedAt))
+    .filter(Boolean)
+    .sort((left, right) =>
+      `${left.department}|${left.locality}|${left.name}`.localeCompare(
+        `${right.department}|${right.locality}|${right.name}`,
+        "es",
+      ),
+    );
+
+  await mkdir(dirname(outputPath), { recursive: true });
+  await writeFile(
+    outputPath,
+    `${JSON.stringify(
+      {
+        metadata: {
+          sourceKey: "openstreetmap-elepem-uy",
+          sourceType: "osm",
+          sourceUrl: OVERPASS_ENDPOINT,
+          sourceLicense: "ODbL-1.0",
+          attribution: "© OpenStreetMap contributors",
+          retrievedAt,
+          query: OVERPASS_QUERY,
+          recordCount: candidates.length,
+          warning:
+            "Son candidatos encontrados por etiquetas OSM. No equivalen a ELEPEM verificados ni a un estado administrativo.",
+        },
+        candidates,
+      },
+      null,
+      2,
+    )}\n`,
+    "utf8",
+  );
+
+  console.log(`Guardados ${candidates.length} candidatos OSM en ${outputPath}`);
+}
+
+main().catch((error) => {
+  console.error(error instanceof Error ? error.message : error);
+  process.exitCode = 1;
+});
