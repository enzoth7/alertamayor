+import type { AnchorHTMLAttributes } from "react";
+
+export type GoogleMapsReviewLinkProps = Omit<
+  AnchorHTMLAttributes<HTMLAnchorElement>,
+  "href" | "target" | "rel"
+> & {
+  name: string;
+  placeId: string;
+  children?: React.ReactNode;
+};
+
+/**
+ * Opens the exact Google Maps place page without copying or persisting reviews.
+ * Google Maps URLs do not require an API key.
+ */
+export default function GoogleMapsReviewLink({
+  name,
+  placeId,
+  children = "Ver ficha y reseñas en Google Maps",
+  ...anchorProps
+}: GoogleMapsReviewLinkProps) {
+  const normalizedName = name.trim();
+  const normalizedPlaceId = placeId.trim();
+
+  if (!normalizedName || !normalizedPlaceId) return null;
+
+  const href =
+    "https://www.google.com/maps/search/?api=1" +
+    `&query=${encodeURIComponent(normalizedName)}` +
+    `&query_place_id=${encodeURIComponent(normalizedPlaceId)}`;
+
+  return (
+    <a
+      {...anchorProps}
+      href={href}
+      target="_blank"
+      rel="noopener noreferrer"
+    >
+      {children}
+    </a>
+  );
+}
