+#!/usr/bin/env python3
+"""Calcula alfa de Krippendorff nominal para la etiqueta specific_signal."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter, defaultdict
+from typing import Any
+
+import pandas as pd
+
+
+def parse_bool(value: Any) -> str:
+    normalized = str(value).strip().lower()
+    if normalized in {"1", "true", "t", "yes", "si", "sí"}:
+        return "true"
+    if normalized in {"0", "false", "f", "no"}:
+        return "false"
+    raise ValueError(f"Etiqueta booleana inválida: {value!r}")
+
+
+def krippendorff_alpha_nominal(units: list[list[str]]) -> float | None:
+    coincidence: Counter[tuple[str, str]] = Counter()
+    categories: set[str] = set()
+
+    for ratings in units:
+        if len(ratings) < 2:
+            continue
+        counts = Counter(ratings)
+        categories.update(counts)
+        denominator = len(ratings) - 1
+        for left, left_count in counts.items():
+            for right, right_count in counts.items():
+                pairs = left_count * (right_count - (1 if left == right else 0))
+                coincidence[(left, right)] += pairs / denominator
+
+    n = sum(coincidence.values())
+    if n <= 1:
+        return None
+
+    marginals = {
+        category: sum(coincidence[(category, other)] for other in categories)
+        for category in categories
+    }
+    observed_disagreement = (
+        sum(value for (left, right), value in coincidence.items() if left != right) / n
+    )
+    expected_disagreement = (
+        sum(
+            marginals[left] * marginals[right]
+            for left in categories
+            for right in categories
+            if left != right
+        )
+        / (n * (n - 1))
+    )
+    if expected_disagreement == 0:
+        return 1.0 if observed_disagreement == 0 else None
+    return 1.0 - observed_disagreement / expected_disagreement
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", required=True)
+    parser.add_argument("--unit-column", default="review_id")
+    parser.add_argument("--annotator-column", default="annotator_id")
+    parser.add_argument("--label-column", default="specific_signal")
+    args = parser.parse_args()
+
+    frame = pd.read_csv(args.input)
+    required = {args.unit_column, args.annotator_column, args.label_column}
+    missing = required.difference(frame.columns)
+    if missing:
+        raise ValueError(f"Faltan columnas: {', '.join(sorted(missing))}")
+
+    annotations: dict[str, dict[str, str]] = defaultdict(dict)
+    for row in frame.itertuples(index=False):
+        data = row._asdict()
+        unit = str(data[args.unit_column]).strip()
+        annotator = str(data[args.annotator_column]).strip()
+        if not unit or not annotator:
+            continue
+        annotations[unit][annotator] = parse_bool(data[args.label_column])
+
+    units = [list(values.values()) for values in annotations.values() if len(values) >= 2]
+    alpha = krippendorff_alpha_nominal(units)
+    pairwise_agreement_numerator = sum(
+        sum(1 for i in range(len(ratings)) for j in range(i + 1, len(ratings)) if ratings[i] == ratings[j])
+        for ratings in units
+    )
+    pairwise_agreement_denominator = sum(
+        len(ratings) * (len(ratings) - 1) // 2 for ratings in units
+    )
+    report = {
+        "units_with_two_or_more_annotations": len(units),
+        "annotation_count": sum(len(ratings) for ratings in units),
+        "pairwise_agreement": (
+            pairwise_agreement_numerator / pairwise_agreement_denominator
+            if pairwise_agreement_denominator
+            else None
+        ),
+        "krippendorff_alpha_nominal": alpha,
+    }
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
