@@ -0,0 +1,192 @@
+import { NextRequest, NextResponse } from "next/server";
+import { hasTeamSession, TEAM_SESSION_COOKIE } from "../../../../lib/team-session";
+import { querySupabaseDatabase } from "../../../../lib/supabase-db";
+
+export const runtime = "nodejs";
+
+const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const ALLOWED_STATUSES = new Set([
+  "discovered",
+  "possible_match",
+  "needs_review",
+  "verified_new",
+  "verified_match",
+  "rejected",
+  "duplicate",
+  "closed",
+]);
+
+type JsonRecord = Record<string, unknown>;
+
+function record(value: unknown): JsonRecord {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as JsonRecord)
+    : {};
+}
+
+function text(value: unknown, maxLength: number): string {
+  return typeof value === "string" ? value.trim().slice(0, maxLength) : "";
+}
+
+function integer(value: string | null, fallback: number): number {
+  const parsed = Number(value);
+  return Number.isInteger(parsed) ? parsed : fallback;
+}
+
+export async function GET(request: NextRequest) {
+  if (!hasTeamSession(request.cookies.get(TEAM_SESSION_COOKIE)?.value)) {
+    return NextResponse.json({ error: "La sesión de equipo venció. Volvé a ingresar." }, { status: 401 });
+  }
+
+  const { searchParams } = new URL(request.url);
+  const requestedStatus = text(searchParams.get("status"), 40);
+  const status = ALLOWED_STATUSES.has(requestedStatus) ? requestedStatus : "";
+  const department = text(searchParams.get("department"), 100);
+  const limit = Math.min(Math.max(integer(searchParams.get("limit"), 100), 1), 200);
+
+  try {
+    const candidates = await querySupabaseDatabase<{
+      id: string;
+      canonical_key: string;
+      status: string;
+      name: string;
+      department: string | null;
+      locality: string | null;
+      address: string | null;
+      lat: number | null;
+      lng: number | null;
+      best_match_residencial_id: string | null;
+      best_match_score: string | null;
+      match_details: JsonRecord;
+      evidence_count: number;
+      evidence_tier: string;
+      public_eligible: boolean;
+      review_note: string | null;
+      reviewed_by: string | null;
+      reviewed_at: string | null;
+      created_at: string;
+      updated_at: string;
+      sources: unknown;
+    }>(
+      `select
+         candidate.*,
+         coalesce((
+           select jsonb_agg(
+             jsonb_build_object(
+               'source_type', observation.source_type,
+               'source_record_key', observation.source_record_key,
+               'external_id', observation.external_id,
+               'external_url', observation.external_url,
+               'source_license', observation.source_license,
+               'retrieved_at', observation.retrieved_at
+             ) order by observation.retrieved_at desc, observation.id
+           )
+           from public.facility_candidate_sources link
+           join public.facility_source_observations observation
+             on observation.id = link.observation_id
+           where link.candidate_id = candidate.id
+         ), '[]'::jsonb) as sources
+       from public.facility_candidates candidate
+       where ($1 = '' or candidate.status = $1)
+         and ($2 = '' or candidate.department = $2)
+       order by
+         case candidate.status
+           when 'needs_review' then 1
+           when 'possible_match' then 2
+           when 'discovered' then 3
+           else 4
+         end,
+         candidate.evidence_tier,
+         candidate.best_match_score desc nulls last,
+         candidate.updated_at desc
+       limit $3`,
+      [status, department, limit],
+    );
+
+    return NextResponse.json({ candidates }, { headers: { "Cache-Control": "no-store" } });
+  } catch (error) {
+    console.error("Facility candidate fetch failed.", {
+      message: error instanceof Error ? error.message : "Unknown error",
+    });
+    return NextResponse.json({ error: "No se pudo cargar la cola de verificación." }, { status: 502 });
+  }
+}
+
+export async function PATCH(request: NextRequest) {
+  if (!hasTeamSession(request.cookies.get(TEAM_SESSION_COOKIE)?.value)) {
+    return NextResponse.json({ error: "La sesión de equipo venció. Volvé a ingresar." }, { status: 401 });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: "No se pudo leer la revisión." }, { status: 400 });
+  }
+
+  const input = record(body);
+  const candidateId = text(input.candidateId, 36);
+  const status = text(input.status, 40);
+  const matchId = text(input.bestMatchResidencialId, 300);
+  const note = text(input.note, 4_000);
+  const reviewedBy = text(input.reviewedBy, 200) || "team";
+
+  if (!UUID_PATTERN.test(candidateId)) {
+    return NextResponse.json({ error: "El candidato no es válido." }, { status: 400 });
+  }
+  if (!ALLOWED_STATUSES.has(status)) {
+    return NextResponse.json({ error: "El estado de revisión no es válido." }, { status: 400 });
+  }
+  if (status === "verified_match" && !matchId) {
+    return NextResponse.json(
+      { error: "Para confirmar una coincidencia tenés que indicar el residencial existente." },
+      { status: 400 },
+    );
+  }
+
+  try {
+    const rows = await querySupabaseDatabase<{
+      id: string;
+      status: string;
+      best_match_residencial_id: string | null;
+      evidence_tier: string;
+      public_eligible: boolean;
+      review_note: string | null;
+      reviewed_by: string | null;
+      reviewed_at: string;
+      updated_at: string;
+    }>(
+      `update public.facility_candidates
+       set status = $2,
+           best_match_residencial_id = case
+             when $2 = 'verified_match' then nullif($3, '')
+             when $2 = 'verified_new' then null
+             else best_match_residencial_id
+           end,
+           review_note = nullif($4, ''),
+           reviewed_by = $5,
+           reviewed_at = now(),
+           public_eligible = case
+             when $2 in ('verified_new', 'verified_match') and evidence_tier in ('A', 'B')
+               then true
+             else false
+           end,
+           updated_at = now()
+       where id = $1
+       returning id, status, best_match_residencial_id, evidence_tier,
+                 public_eligible, review_note, reviewed_by, reviewed_at, updated_at`,
+      [candidateId, status, matchId, note, reviewedBy],
+    );
+
+    const candidate = rows[0];
+    if (!candidate) {
+      return NextResponse.json({ error: "No se encontró el candidato." }, { status: 404 });
+    }
+    return NextResponse.json({ candidate });
+  } catch (error) {
+    console.error("Facility candidate review failed.", {
+      message: error instanceof Error ? error.message : "Unknown error",
+    });
+    return NextResponse.json({ error: "No se pudo guardar la revisión." }, { status: 502 });
+  }
+}
