@@ -0,0 +1,94 @@
+export type IdeGeocodeResult = {
+  lat: number;
+  lng: number;
+  raw: unknown;
+};
+
+const DEFAULT_ENDPOINT = "https://direcciones.ide.uy/api/v1/geocode/direcUnica";
+
+function firstFiniteNumber(values: unknown[]): number | null {
+  for (const value of values) {
+    const number = typeof value === "string" ? Number(value.replace(",", ".")) : Number(value);
+    if (Number.isFinite(number)) return number;
+  }
+  return null;
+}
+
+function objectRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function extractCoordinates(payload: unknown): { lat: number; lng: number } | null {
+  const root = objectRecord(payload);
+  const candidates = [
+    root,
+    objectRecord(root.resultado),
+    objectRecord(root.result),
+    objectRecord(root.direccion),
+    objectRecord(Array.isArray(root.features) ? root.features[0] : null),
+  ];
+
+  for (const candidate of candidates) {
+    const geometry = objectRecord(candidate.geometry);
+    const coordinates = Array.isArray(geometry.coordinates) ? geometry.coordinates : [];
+    const lat = firstFiniteNumber([
+      candidate.lat,
+      candidate.latitude,
+      candidate.y,
+      coordinates[1],
+    ]);
+    const lng = firstFiniteNumber([
+      candidate.lng,
+      candidate.lon,
+      candidate.longitude,
+      candidate.x,
+      coordinates[0],
+    ]);
+    if (lat !== null && lng !== null) return { lat, lng };
+  }
+
+  return null;
+}
+
+/**
+ * Geocodifica una dirección con el servicio público de IDE Uruguay.
+ *
+ * El servicio se mantiene en beta y su contrato debe verificarse en Swagger.
+ * Por eso el nombre del parámetro de texto es configurable mediante
+ * IDE_DIREC_UNICA_TEXT_PARAM. El valor inicial "texto" se puede cambiar sin
+ * modificar código si el Swagger vigente utiliza otro nombre.
+ */
+export async function geocodeWithIdeUruguay(
+  query: string,
+  options: { signal?: AbortSignal; limit?: number } = {},
+): Promise<IdeGeocodeResult | null> {
+  const normalizedQuery = query.trim();
+  if (!normalizedQuery) return null;
+
+  const endpoint = process.env.IDE_DIREC_UNICA_ENDPOINT || DEFAULT_ENDPOINT;
+  const textParameter = process.env.IDE_DIREC_UNICA_TEXT_PARAM || "texto";
+  const url = new URL(endpoint);
+  url.searchParams.set(textParameter, normalizedQuery);
+  url.searchParams.set("limit", String(options.limit ?? 1));
+
+  const response = await fetch(url, {
+    headers: { Accept: "application/json" },
+    signal: options.signal,
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    const body = await response.text().catch(() => "");
+    throw new Error(
+      `IDE Uruguay respondió ${response.status}. Verificá IDE_DIREC_UNICA_TEXT_PARAM en Swagger.${
+        body ? ` Detalle: ${body.slice(0, 300)}` : ""
+      }`,
+    );
+  }
+
+  const payload: unknown = await response.json();
+  const coordinates = extractCoordinates(payload);
+  return coordinates ? { ...coordinates, raw: payload } : null;
+}
