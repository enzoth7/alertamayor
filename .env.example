TEAM_DEMO_USERNAME=user
TEAM_DEMO_PASSWORD=password
TEAM_SESSION_SECRET=replace-with-a-long-random-secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required only by the organization inbox, which currently connects directly
# to Postgres from the server:
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=replace-with-your-database-password
SUPABASE_DB_HOST=your-pooler-host
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.your-project-ref

# Supabase Edge Function secrets (configure in the Supabase dashboard,
# not in this Next.js file):
# RESEND_API_KEY=re_replace_me
# RESEND_FROM_EMAIL=Alerta Mayor <seguimiento@your-domain.example>
